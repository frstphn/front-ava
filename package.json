{
  "name": "front-ava",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/front-ava/ && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
